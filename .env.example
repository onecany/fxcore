# FXcore 服务端环境变量（复制为 .env 使用；.env 被 gitignore，不入库）
#
# 加载顺序（后加载者不覆盖已存在的值）：
#   1. 进程环境变量（shell export / systemd Environment）优先
#   2. .env 文件（ENV_FILE 指定路径，默认工作目录下 .env）
#
# 生产部署建议：JWT_SECRET、RSA_PRIVATE_KEY、ADMIN_PASSWORD 必须显式设置，
# 留空会有"重启后全部失效"或"弱凭据"的风险（见各变量注释）。

# 监听端口（默认 8080）
PORT=8080

# 管理员种子账号（内存存储，首次启动写入）
ADMIN_EMAIL=admin@fxcore.local
# 生产必须改！默认 admin123 仅限本地开发
ADMIN_PASSWORD=admin123
# 管理员请求签名密钥 user_secret；留空则每次启动随机生成
# （前端登录后拿到一次；重启后旧 secret 失效需重新登录）
ADMIN_SIGN_SECRET=

# access token 签名密钥；留空则每次启动随机生成
# （重启后所有已签发 token 立即失效，客户端走刷新流程）
JWT_SECRET=

# API Key 加密私钥（PEM 或 base64(PEM)，2048 位 RSA）；
# 留空则启动时生成、仅存内存（重启后已加密存储的 API Key 无法解密，需重新录入）
RSA_PRIVATE_KEY=

# Redis 连接串；refresh token / 限流 / nonce 防重放存储。
# 留空则降级为进程内内存实现（仅适用于单实例；多实例必须配 Redis）
REDIS_URL=redis://localhost:6379/0

# 追加 CORS 白名单（逗号分隔）。
# 默认已含：https://cany.one + http(s)://localhost|127.0.0.1:5173/6000/8080
CORS_ORIGINS=

# HTTPS + HTTP/2：两个都设置才启用（TLS 下 Go 通过 ALPN 自动协商 h2）。
# 明文环境自动降级 HTTP/1.1。证书可用 mkcert / certbot / 自签生成。
# TLS_CERT_FILE=/etc/fxcore/fxcore.crt.pem
# TLS_KEY_FILE=/etc/fxcore/fxcore.key.pem

# 日志目录（应用日志 fxcore.log + API 访问日志 access.log，10MiB 轮转 x7 份压缩；
# 同时镜像到终端）。设空串禁用文件日志，仅终端输出
LOG_DIR=logs

# 可选：.env 文件路径（默认 .env，即工作目录下）。
# systemd 部署可指向固定配置：ENV_FILE=/etc/fxcore/fxcore.env
# ENV_FILE=
